<header class="topbar">
  <a class="logo" href="<%- url_for((theme.topbar && theme.topbar.logo_url) || '/') %>"><%= (theme.topbar && theme.topbar.logo_text) || 'Xiaomi MiMo' %></a>
  <nav>
    <% ((theme.topbar && theme.topbar.nav) || []).forEach(function(item){ %>
      <a href="<%- url_for(item.url || '/') %>"><%= item.text %></a>
    <% }) %>
  </nav>
</header>
